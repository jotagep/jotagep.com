---
//@ts-nocheck
import { ClientRouter } from 'astro:transitions'
import { SEO } from 'astro-seo'

import config from '@/data/config'

import type { Language } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

import HeadHrefLangs from './HeadHrefLangs.astro'

export type Props = {
  seo: {
    publishedTime?: Date
    title?: string
    type?: 'article' | 'website'
    description?: string
    noindex?: boolean
    image?: string
    url?: string
  }
  translatedPostSlug?: string
}

const { seo, translatedPostSlug } = Astro.props

const lang = Astro.currentLocale as Language
const t = useTranslations(lang)

const defaultTitle = t('site.title') || config.title
const defaultDescription = t('site.description') || config.description

const {
  title,
  type = 'website',
  description,
  noindex,
  image,
  url,
  publishedTime,
} = seo

const resolvedImage = image
  ? new URL(image, config.siteUrl).href
  : `${config.siteUrl}og.png`
const resolvedUrl = url || new URL(Astro.url.pathname, config.siteUrl).href

const openGraph = {
  publishedTime,
  title: title || defaultTitle,
  type,
  image: resolvedImage,
  alt: title || defaultTitle,
  url: resolvedUrl,
  description: description || defaultDescription,
}

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: openGraph.title,
        description: openGraph.description,
        image: openGraph.image,
        url: openGraph.url,
        ...(publishedTime && {
          datePublished: publishedTime.toISOString(),
        }),
        author: {
          '@type': 'Person',
          name: config.logoTitle,
          url: config.siteUrl,
          sameAs: config.socials.map((social) => social.link),
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: config.logoTitle,
        jobTitle: 'Product Engineer',
        description: openGraph.description,
        url: config.siteUrl,
        sameAs: config.socials.map((social) => social.link),
      }
---

<head>
  <SEO
    charset="UTF-8"
    title={openGraph.title}
    description={openGraph.description}
    canonical={openGraph.url}
    noindex={noindex || false}
    openGraph={{
      basic: {
        title: openGraph.title,
        type: openGraph.type,
        image: openGraph.image,
        url: openGraph.url,
      },
      image: {
        alt: openGraph.alt,
      },
      ...(openGraph.publishedTime && {
        article: {
          publishedTime: openGraph.publishedTime.toISOString(),
        },
      }),
    }}
    twitter={{
      creator: config.twitter,
    }}
    extend={{
      link: [
        { rel: 'icon', type: 'image/x-icon', href: '/icons/favicon.ico' },
        {
          rel: 'apple-touch-icon',
          sizes: '57x57',
          href: '/icons/apple-icon-57x57.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '60x60',
          href: '/icons/apple-icon-60x60.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '72x72',
          href: '/icons/apple-icon-72x72.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '76x76',
          href: '/icons/apple-icon-76x76.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '114x114',
          href: '/icons/apple-icon-114x114.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '120x120',
          href: '/icons/apple-icon-120x120.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '144x144',
          href: '/icons/apple-icon-144x144.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '152x152',
          href: '/icons/apple-icon-152x152.png',
        },
        {
          rel: 'apple-touch-icon',
          sizes: '180x180',
          href: '/icons/apple-icon-180x180.png',
        },
        {
          rel: 'icon',
          type: 'image/png',
          sizes: '192x192',
          href: '/icons/android-icon-192x192.png',
        },
        {
          rel: 'icon',
          type: 'image/png',
          sizes: '32x32',
          href: '/icons/favicon-32x32.png',
        },
        {
          rel: 'icon',
          type: 'image/png',
          sizes: '96x96',
          href: '/icons/favicon-96x96.png',
        },
        {
          rel: 'icon',
          type: 'image/png',
          sizes: '16x16',
          href: '/icons/favicon-16x16.png',
        },
        { rel: 'manifest', href: '/manifest.json' },
        { rel: 'sitemap', href: '/sitemap-index.xml' },
      ],
      meta: [
        { name: 'viewport', content: 'width=device-width, initial-scale=1' },
        { name: 'generator', content: Astro.generator },
        {
          name: 'twitter:image',
          content: openGraph.image,
        },
        { name: 'twitter:card', content: 'summary_large_image' },
        { name: 'twitter:title', content: openGraph.title },
        { name: 'twitter:description', content: openGraph.description },
        { name: 'twitter:site', content: config.twitter },
      ],
    }}
  />
  <HeadHrefLangs {translatedPostSlug} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <ClientRouter />
  <script>
    document.addEventListener('astro:page-load', () => {
      const darkModeButton =
        document.querySelector<HTMLButtonElement>('#dark-mode')
      if (
        localStorage.theme === 'dark' ||
        (!('theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark')
        darkModeButton.setAttribute('title', 'Toogle light mode')
      } else {
        document.documentElement.classList.remove('dark')
        darkModeButton.setAttribute('title', 'Toogle dark mode')
      }
    })
  </script>
</head>
